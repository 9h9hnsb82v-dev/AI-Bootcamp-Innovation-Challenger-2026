# Add local configuration only. Never commit credentials.
OLLAMA_BASE_URL=http://localhost:11434
# 도구 호출(tool calling)을 지원하는 로컬 모델
OLLAMA_MODEL=benedict/linkbricks-llama3.1-korean:8b
# 빠른 대안(답변 충실도 75%): llama3.2:3b — reports/agent/tool_call_eval.json 참조
# 앱 데이터베이스(SQLite) 경로, 기본값 data/app/resource.db
# RESOURCE_DB=data/app/resource.db
